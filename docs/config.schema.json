{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melodysky.xyz/j2ll/config.schema.json",
  "title": "j2ll config schema v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "jarFile",
    "classPath",
    "javaHome",
    "runtimeImage",
    "worldModel",
    "outputDirectory",
    "whiteList",
    "blackList",
    "embeddedLibraryDirectory",
    "signaturePolicy",
    "signing",
    "intermediates",
    "protection"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jarFile": { "type": "string", "pattern": "\\.jar$" },
    "classPath": { "type": "array", "items": { "type": "string" } },
    "javaHome": { "type": ["string", "null"] },
    "runtimeImage": { "type": ["string", "null"] },
    "worldModel": {
      "type": "string",
      "enum": ["CLOSED_WORLD", "PARTIAL_WORLD", "JDK_EXTERNAL_WORLD", "UNKNOWN_DYNAMIC_WORLD"]
    },
    "outputDirectory": { "type": "string", "minLength": 1 },
    "whiteList": { "type": "array", "items": { "type": "string" } },
    "blackList": { "type": "array", "items": { "type": "string" } },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": ["windowsX64", "windowsArm64", "linuxX64", "linuxArm64", "macosX64", "macosArm64"],
      "properties": {
        "windowsX64": { "type": "boolean" },
        "windowsArm64": { "type": "boolean" },
        "linuxX64": { "type": "boolean" },
        "linuxArm64": { "type": "boolean" },
        "macosX64": { "type": "boolean" },
        "macosArm64": { "type": "boolean" }
      }
    },
    "embeddedLibraryDirectory": {
      "type": "string",
      "pattern": "^(?!java(?:/|$))(?!META-INF(?:/|$))[A-Za-z_$][A-Za-z0-9_$]*(?:/[A-Za-z_$][A-Za-z0-9_$]*)*$"
    },
    "signaturePolicy": { "type": "string", "enum": ["fail", "strip", "resign"] },
    "signing": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "required": ["keystorePath", "storePasswordEnv", "keyAlias", "keyPasswordEnv", "tsaUrl"],
      "properties": {
        "keystorePath": { "type": "string" },
        "storePasswordEnv": { "type": "string" },
        "keyAlias": { "type": "string" },
        "keyPasswordEnv": { "type": "string" },
        "tsaUrl": { "type": ["string", "null"] }
      }
    },
    "intermediates": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "includeDebugDumps", "includePerClassIr", "includePerClassLlvm", "includePerClassC"],
      "properties": {
        "enabled": { "type": "boolean" },
        "includeDebugDumps": { "type": "boolean" },
        "includePerClassIr": { "type": "boolean" },
        "includePerClassLlvm": { "type": "boolean" },
        "includePerClassC": { "type": "boolean" }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "seed", "ir", "llvm", "binary"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "seed": {
          "type": ["string", "null"],
          "description": "null selects a fresh randomized build identity for each default build; a string selects reproducible mode"
        },
        "ir": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "enabled",
            "controlFlowFlattening",
            "fakeBranches",
            "basicBlockSplitting",
            "constantEncryption",
            "stringEncryption",
            "methodInlining",
            "methodSplitting",
            "callIndirection",
            "fieldInternalization",
            "methodInternalization",
            "publicMethodInternalizationAllowList",
            "methodTableHiding",
            "blockNameObfuscation"
          ],
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "controlFlowFlattening": { "type": "boolean", "default": true },
            "fakeBranches": { "type": "boolean", "default": true },
            "basicBlockSplitting": { "type": "boolean", "default": true },
            "constantEncryption": { "type": "boolean", "default": true },
            "stringEncryption": { "type": "boolean", "default": true },
            "methodInlining": { "type": "boolean", "default": true },
            "methodSplitting": { "type": "boolean", "default": true },
            "callIndirection": { "type": "boolean", "default": true },
            "fieldInternalization": {
              "type": "boolean",
              "default": false,
              "description": "Requires CLOSED_WORLD, or interactive build-time approval for current-input-JAR-only analysis. The approval is per run and does not change worldModel."
            },
            "methodInternalization": {
              "type": "boolean",
              "default": false,
              "description": "Removes eligible Java method declarations whose complete input-visible call surface is implemented natively. Requires CLOSED_WORLD, or per-run approval that limits call-site, override, and observer analysis to the current input JAR."
            },
            "publicMethodInternalizationAllowList": {
              "type": "array",
              "default": [],
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[^#*/]+(?:/[^#*/]+)*#[^!*/]+!\\([^)]*\\).+$"
              },
              "description": "Explicit authorization for individual public methods. Every entry must be an exact owner#name!descriptor selector; class selectors and wildcards are forbidden. Public static removal may use declared worldModel=CLOSED_WORLD or the per-run current-input-JAR-only approval. Public instance removal requires declared CLOSED_WORLD plus exact same-owner call sites; it does not require a final method or class. Resolved exact observers still reject a candidate, while unsupported or unbounded reflection/JNI/agent surfaces are reported as user-accepted risk."
            },
            "methodTableHiding": { "type": "boolean", "default": true },
            "blockNameObfuscation": { "type": "boolean", "default": true }
          }
        },
        "llvm": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "enabled",
            "nameObfuscation",
            "opaquePredicates",
            "blockLayoutPerturbation",
            "indirectCalls",
            "globalLayout"
          ],
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "nameObfuscation": { "type": "boolean", "default": true },
            "opaquePredicates": { "type": "boolean", "default": true },
            "blockLayoutPerturbation": { "type": "boolean", "default": true },
            "indirectCalls": { "type": "boolean", "default": true },
            "globalLayout": { "type": "boolean", "default": true }
          }
        },
        "binary": {
          "type": "object",
          "additionalProperties": true,
          "required": ["enabled", "hideInternalSymbols", "strip", "removePdb", "symbolAudit", "retainUnwindInfo"],
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "hideInternalSymbols": { "type": "boolean", "default": true },
            "strip": { "type": "boolean", "default": true },
            "removePdb": { "type": "boolean", "default": true },
            "symbolAudit": { "type": "boolean", "default": true },
            "retainUnwindInfo": { "type": "boolean", "default": false }
          }
        }
      }
    }
  }
}
